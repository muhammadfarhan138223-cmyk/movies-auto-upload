# Copy to .env, preserve your original API credentials. NEVER commit .env.
STREAMTAPE_LOGIN=
STREAMTAPE_KEY=
DOODSTREAM_KEY=
PORT=8766

# Optional remote PWA status (follow docs/MOBILE_SETUP.md). These belong ONLY on the laptop.
UPLOAD_SYNC_SUPABASE_URL=
UPLOAD_SYNC_PUBLISHABLE_KEY=
UPLOAD_SYNC_AGENT_EMAIL=
UPLOAD_SYNC_AGENT_PASSWORD=

# Additional providers (never publish keys)
FILEMOON_API_TOKEN=
STREAMWISH_API_KEY=

# OPTIONAL: private full-control mobile PWA via Cloudflare Access + Tunnel.
# Follow docs/CLOUDFLARE_REMOTE_CONTROL.md. No Supabase or Vercel needed.
# NEVER commit your real values from .env.
REMOTE_ENABLED=0
REMOTE_HOST=autoupload.farhanbalouch.com
REMOTE_PORT=8767
REMOTE_ACCESS_TEAM_DOMAIN=YOUR_TEAM.cloudflareaccess.com
REMOTE_ACCESS_AUD=YOUR_CLOUDFLARE_APPLICATION_AUDIENCE_TAG
REMOTE_ACCESS_EMAIL=YOUR_APPROVED_GMAIL_ADDRESS
